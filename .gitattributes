# Normalise line endings on checkout.
#
# Without this, cloning on Windows gives install_pi.sh CRLF endings, and running
# it on a Pi fails with "bad interpreter: /usr/bin/env bash^M". Shell scripts and
# systemd units must stay LF wherever they are checked out.

* text=auto

*.sh        text eol=lf
*.service   text eol=lf
*.py        text eol=lf
Makefile    text eol=lf

*.bat       text eol=crlf
*.cmd       text eol=crlf

*.db        binary
*.png       binary
*.jpg       binary
